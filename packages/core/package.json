{
  "name": "@proseharbor-editor/core",
  "version": "0.0.1",
  "description": "基于 ProseMirror 的轻量、可插拔富文本编辑器内核",
  "license": "MIT",
  "keywords": [
    "editor",
    "rich-text",
    "rich-text-editor",
    "wysiwyg",
    "prosemirror",
    "proseharbor"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "umd": "./dist/index.umd.js",
  "unpkg": "./dist/index.umd.js",
  "jsdelivr": "./dist/index.umd.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./umd": "./dist/index.umd.js",
    "./dist/index.umd.js": "./dist/index.umd.js",
    "./locales": "./dist/locales/index.js",
    "./locales/*": "./dist/locales/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "dist",
    "!dist/**/*.map"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chencunxin/proseharbor-editor.git"
  },
  "bugs": {
    "url": "https://github.com/chencunxin/proseharbor-editor/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build && vite build --config vite.umd.config.ts && vite build --config vite.locales.config.ts",
    "typecheck": "tsc --noEmit",
    "prepack": "yarn build"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-bold": "^3.32.0",
    "@tiptap/extension-bubble-menu": "^3.32.0",
    "@tiptap/extension-bullet-list": "^3.32.0",
    "@tiptap/extension-code": "^3.32.0",
    "@tiptap/extension-code-block": "^3.32.0",
    "@tiptap/extension-document": "^3.32.0",
    "@tiptap/extension-italic": "^3.32.0",
    "@tiptap/extension-link": "^3.32.0",
    "@tiptap/extension-list": "^3.32.0",
    "@tiptap/extension-list-item": "^3.32.0",
    "@tiptap/extension-ordered-list": "^3.32.0",
    "@tiptap/extension-strike": "^3.32.0",
    "@tiptap/extension-subscript": "^3.32.0",
    "@tiptap/extension-superscript": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/extension-table-cell": "^3.32.0",
    "@tiptap/extension-table-header": "^3.32.0",
    "@tiptap/extension-table-row": "^3.32.0",
    "@tiptap/extension-task-item": "^3.32.0",
    "@tiptap/extension-task-list": "^3.32.0",
    "@tiptap/extension-text": "^3.32.0",
    "@tiptap/extension-typography": "^3.32.0",
    "@tiptap/extension-underline": "^3.32.0",
    "@tiptap/extensions": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/suggestion": "^3.32.0",
    "cheerio": "^1.0.0",
    "i18next": "^26.5.11",
    "lodash": "^4.18.1",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@types/lodash": "^4",
    "@types/node": "^22.13.1",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vite-plugin-dts": "^4.5.0"
  }
}
